# Files executed or parsed on Linux must keep LF line endings even when checked out on Windows
# (a CRLF bootstrap.sh fails with "$'\r': command not found").
* text=auto
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
.env*       text eol=lf
