{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PowerTheIngressInstanceOnly",
      "Effect": "Allow",
      "Action": [
        "lightsail:StartInstance",
        "lightsail:StopInstance"
      ],
      "Resource": "arn:aws:lightsail:<REGION>:<ACCOUNT_ID>:Instance/<INSTANCE_RESOURCE_ID>"
    },
    {
      "Sid": "ReadAndAllocateNoResourceScopingPossible",
      "Effect": "Allow",
      "Action": [
        "lightsail:GetInstance",
        "lightsail:GetStaticIp",
        "lightsail:GetStaticIps",
        "lightsail:AllocateStaticIp"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<REGION>"
        }
      }
    },
    {
      "Sid": "ManageStaticIpsInThisRegion",
      "Effect": "Allow",
      "Action": [
        "lightsail:DetachStaticIp",
        "lightsail:ReleaseStaticIp"
      ],
      "Resource": "arn:aws:lightsail:<REGION>:<ACCOUNT_ID>:StaticIp/*"
    },
    {
      "Sid": "AttachStaticIpsToTheIngressInstanceOnly",
      "Effect": "Allow",
      "Action": [
        "lightsail:AttachStaticIp"
      ],
      "Resource": [
        "arn:aws:lightsail:<REGION>:<ACCOUNT_ID>:StaticIp/*",
        "arn:aws:lightsail:<REGION>:<ACCOUNT_ID>:Instance/<INSTANCE_RESOURCE_ID>"
      ]
    }
  ]
}
