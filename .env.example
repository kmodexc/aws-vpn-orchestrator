# =============================================================================================
# vpn-control — configuration and secrets (documentation template)
# =============================================================================================
#
# DO NOT copy this file and type secrets by hand. Generate a complete .env with fresh,
# cryptographically random secrets instead, then fill in the remaining placeholders:
#
#     umask 077        # the new file is created 0600 right away, never world-readable
#     docker compose run --rm --no-deps -T app gen-env > .env
#     chmod 600 .env
#
# (`--no-deps`: no other services needed. `-T`: no pseudo-TTY, so the output keeps LF line endings.
#  gen-env needs no other variables; the first run builds the image. When ROTATING secrets,
#  write to .env.new instead and merge — `> .env` would overwrite your current file.)
#
# Rules
#   * .env is the ONLY place that holds configuration and secrets. It is git-ignored and
#     docker-ignored (never baked into an image). Keep it at mode 0600, owned by the deploy user.
#   * The app validates every variable at startup and refuses to start on a missing/invalid one.
#     The error names the variable, never its value.
#   * Values are single-line, unquoted. Variables shown commented out have the default given.
#   * Back up .env offline (password manager / encrypted). Losing it means re-provisioning all
#     clients; leaking it means rotating everything (see docs/security.md).
#
# Legend:  [required]  must be set      [secret]  treat like a password
#          [aws]       required unless PROVIDER=fake
# =============================================================================================


# ---------------------------------------------------------------------------------------------
# Public endpoint (Apache vhost + app)
# ---------------------------------------------------------------------------------------------

# [required] Public DNS name of this control plane (A and/or AAAA record -> this server).
# Must match ServerName in the Apache vhost (deploy/apache/vpn-control.conf); the certificate
# comes from certbot on the host.
DOMAIN=vpn.example.com

# [required] Must be exactly https://<DOMAIN>, https only, no trailing slash. Used for the
# subscription URL, the OIDC redirect URI (<PUBLIC_BASE_URL>/auth/callback) and the CSRF
# Origin check.
PUBLIC_BASE_URL=https://vpn.example.com

# [compose] Host port the app is published on — 127.0.0.1 ONLY, never a public interface.
# Apache proxies to it (ProxyPass / http://127.0.0.1:<APP_HOST_PORT>/).
# Port convention 1xxyy: xx = id of this compose stack (01-99), yy = forwarded port of the
# stack (01-99, in order). This stack forwards exactly one port, so yy = 01.
APP_HOST_PORT=11001

# [compose] Image to run. Built and published by GitHub Actions (.github/workflows/image.yml).
# Pin a commit tag (sha-<short commit>) rather than latest, so you know exactly what runs and can
# roll back; tags are listed at https://github.com/kmodexc/aws-vpn-orchestrator/pkgs/container/aws-vpn-orchestrator
VPN_CONTROL_IMAGE=ghcr.io/kmodexc/aws-vpn-orchestrator:latest


# ---------------------------------------------------------------------------------------------
# Server / runtime
# ---------------------------------------------------------------------------------------------

# Listen address inside the container. docker-compose.yml pins it to 0.0.0.0:8080 and publishes
# it on the host as 127.0.0.1:${APP_HOST_PORT} only (see below).
# BIND_ADDR=0.0.0.0:8080

# Log filter (tracing EnvFilter syntax), e.g. info, warn, vpn_control=debug.
# Secrets, tokens, cookies and token paths are never logged at any level.
# RUST_LOG=info

# json (production) or pretty (local development).
# LOG_FORMAT=json

# If true, the client IP is the RIGHT-MOST X-Forwarded-For entry. docker-compose.yml forces
# this to true because only Apache on localhost can reach the app and mod_proxy APPENDS the real
# client address to X-Forwarded-For. Leave it false
# whenever the app is reachable directly (e.g. `cargo run`), or clients could spoof their IP
# and evade rate limiting.
# TRUST_PROXY_HEADERS=false

# Persistent state (event log, burned IPs). A named volume in docker compose. No secrets.
# STATE_DIR=/data

# Directory with the built SPA (baked into the image).
# STATIC_DIR=/app/static


# ---------------------------------------------------------------------------------------------
# Authentication — Keycloak at https://auth.kmode.dev (see docs/keycloak.md)
# ---------------------------------------------------------------------------------------------

# [required] Realm issuer URL, https only, no trailing slash.
OIDC_ISSUER_URL=https://auth.kmode.dev/realms/<realm>

# [required] Confidential client used for the browser login (BFF; tokens never reach the
# browser). Redirect URI configured in Keycloak: <PUBLIC_BASE_URL>/auth/callback
OIDC_CLIENT_ID=console

# [required][secret] Client secret from Keycloak: Clients -> console -> Credentials.
OIDC_CLIENT_SECRET=

# Realm role (or client role of OIDC_CLIENT_ID) a user must have. Authenticated users without
# it get 403.
# OIDC_REQUIRED_ROLE=vpn-admin

# Optional role for people who only use the VPN: they can sign in and see the subscription
# URL / QR code, nothing else (no start/stop/rotate, no event log, no settings). Off unless set
# (an upgrade never grants access to an existing role by accident). Must differ from
# OIDC_REQUIRED_ROLE; a user with both roles is an admin.
# OIDC_USER_ROLE=vpn-user

# Comma-separated client ids whose access tokens are accepted as Bearer tokens (checked via
# the `azp` claim). Defaults to OIDC_CLIENT_ID only. Add the Android app's public client here,
# e.g. console,console-android
# OIDC_ALLOWED_CLIENTS=console

# Scopes requested at login.
# OIDC_SCOPES=openid profile email

# Browser session lifetime: idle timeout (30 min) and absolute timeout (12 h), in seconds.
# SESSION_IDLE_TIMEOUT_S=1800
# SESSION_ABSOLUTE_TIMEOUT_S=43200


# ---------------------------------------------------------------------------------------------
# Ingress provider — AWS (IAM policies: deploy/iam/lightsail.json, deploy/iam/ec2.json)
# ---------------------------------------------------------------------------------------------

# lightsail | ec2 | fake   (fake = in-memory, for local development only; logs a loud warning)
PROVIDER=lightsail

# [aws] Region of the ingress instance, e.g. eu-central-1, ap-northeast-1, ap-southeast-1.
AWS_REGION=ap-northeast-1

# [aws][secret] Access key of a DEDICATED IAM user that has only the policy from deploy/iam/.
# Never use root or an admin key. Rotate regularly (see docs/security.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# [aws] Lightsail: the instance NAME (e.g. vpn-ingress). EC2: the instance ID (i-0123…).
INGRESS_INSTANCE=vpn-ingress

# Minimum seconds between two IP rotations.
# ROTATE_COOLDOWN_S=120


# ---------------------------------------------------------------------------------------------
# Path tokens (generated by gen-env)
# ---------------------------------------------------------------------------------------------

# [required][secret] Token in the subscription URL <PUBLIC_BASE_URL>/s/<SUB_TOKEN>.
# >= 32 chars of [A-Za-z0-9_-]. Anyone with this URL gets working proxy credentials.
SUB_TOKEN=

# [required][secret] Token the ingress uses to pull its config:
# <PUBLIC_BASE_URL>/i/<INGRESS_TOKEN>/config.json. >= 32 chars of [A-Za-z0-9_-], must differ
# from SUB_TOKEN. Also set in deploy/ingress/bootstrap.sh on the ingress instance.
INGRESS_TOKEN=


# ---------------------------------------------------------------------------------------------
# Subscription / client profile
# ---------------------------------------------------------------------------------------------

# Profile name shown in clients and used as link-name prefix. [A-Za-z0-9_-]{1,32}
# PROFILE_NAME=travel

# How often clients should refresh the subscription (hours).
# SUB_UPDATE_HOURS=1


# ---------------------------------------------------------------------------------------------
# sing-box protocols (generated by gen-env, except SNIs/ports)
# ---------------------------------------------------------------------------------------------

# TLS server names the protocols impersonate. REALITY_SNI must be a real, reachable TLS 1.3
# site (the REALITY handshake is forwarded to it on port 443).
# REALITY_SNI=www.microsoft.com
# HY2_SNI=www.bing.com

# Defaults of the protocol settings. They can be changed at runtime in the web UI
# ("Protocol settings", /api/settings); a change there overrides REALITY_SNI, HY2_SNI and these.
# HY2_OBFS = Salamander obfuscation for Hysteria2 (needs a client that supports it).
# Where censorship is strong (e.g. China), consider SS_ENABLED=false: Shadowsocks is easy to
# detect and can get the ingress IP blocked for all protocols.
# HY2_ENABLED=true
# HY2_OBFS=false
# SS_ENABLED=true

# Listen ports on the ingress. VLESS = TCP, Hysteria2 = UDP, Shadowsocks = TCP+UDP.
# Open exactly these in the Lightsail firewall / EC2 security group and in bootstrap.sh.
# VLESS_PORT=443
# HY2_PORT=443
# SS_PORT=8443

# [required][secret] VLESS user id (UUID v4).
VLESS_UUID=

# [required][secret] REALITY x25519 private key, base64url without padding.
REALITY_PRIVATE_KEY=

# [required] Matching public key (checked against the private key at startup).
REALITY_PUBLIC_KEY=

# [required] REALITY short id, exactly 16 hex characters.
REALITY_SHORT_ID=

# [required][secret] Hysteria2 password.
HY2_PASSWORD=

# [required] Standard base64 of the self-signed PEM certificate (CN/SAN = HY2_SNI). Clients pin
# its SHA-256, so changing it requires clients to refresh the subscription.
HY2_CERT_PEM_B64=

# [required][secret] Standard base64 of the matching PEM private key.
HY2_KEY_PEM_B64=

# [required][secret] Shadowsocks-2022 (2022-blake3-aes-128-gcm) key: standard base64 of
# exactly 16 random bytes.
SS_PASSWORD=


# ---------------------------------------------------------------------------------------------
# Optional: WireGuard exit — ingress sends all proxied traffic out via this VPS
# ---------------------------------------------------------------------------------------------

# WG_ENABLED=false

# [if WG] Public endpoint of the WireGuard peer on the VPS, host:port.
# WG_VPS_ENDPOINT=vpn.example.com:51820

# [if WG] The VPS peer's public key (standard base64).
# WG_VPS_PUBLIC_KEY=

# [if WG][secret] The ingress' WireGuard private key (standard base64, generated by gen-env).
# WG_INGRESS_PRIVATE_KEY=

# Tunnel address of the ingress and tunnel MTU.
# WG_INGRESS_ADDRESS=10.66.0.2/32
# WG_MTU=1380
